{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试：FastAPI 服务（uvicorn）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["greentrace.api:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "GREENTRACE_DATA_DIR": "${workspaceFolder}/data",
        "GREENTRACE_LOG_LEVEL": "INFO"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "调试：CLI 演示",
      "type": "debugpy",
      "request": "launch",
      "module": "greentrace.demo",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "调试：当前文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "调试：当前测试文件",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
